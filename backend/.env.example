# Copy this file to backend/.env and fill in your key.
# (A .env at the repo root also works — python-dotenv searches parent dirs.)
OPENAI_API_KEY=your-openai-api-key-here

# JWT signing secret for login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it the server falls back to an INSECURE dev secret (with a warning).
JWT_SECRET=your-random-secret-here

# Admin account, seeded into the users table at every boot (role=admin,
# unlimited daily usage). Logging in with these credentials unlocks the
# admin dashboard. Rotating the password takes effect on restart.
ADMIN_ID=admin@agrisage.app
ADMIN_PASSWORD=change-me

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: path to a trained classifier checkpoint. If unset, the
# pipeline falls back to a mock low-confidence prediction so the
# RAG/LLM layer can be developed/tested before training finishes.
# MODEL_CHECKPOINT_PATH=backend/models/saved/models/<name>/<run>/model_best.pth
# MODEL_CONFIG_PATH=backend/models/config3.json
