# Keep the build context (and final image) small. NOTE: do NOT exclude
# backend/models/weights/ — the committed classifier checkpoint must ship.

.git
.gitignore
.claude
.claude/**

# Python
.venv
**/__pycache__
**/*.py[cod]
.mypy_cache
.ruff_cache

# Training-only assets — inference reads the checkpoint in weights/ and the
# class names in weights/classes.json, never these. They are gitignored (so
# Cloud Build's clone never sees them) but huge on a dev machine, where
# `gcloud run deploy --source .` would otherwise upload the whole dataset.
backend/models/dataset/
backend/models/saved/

# Node / Tailwind (rebuilt in the Node stage)
**/node_modules
frontend/css/styles.css

# Secrets — never bake these into the image
.env
backend/.env
**/*.env

# Runtime data (regenerated at runtime)
backend/uploads/
backend/db/*.db
backend/ai/rag/data/embeddings_cache.json

# Docs / deploy config that the image doesn't need
render.yaml
*.md
scripts/
